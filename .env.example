# Environment variables for SmartAlert Risk Analysis Kickstarter

# MongoDB configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=kickstarter_db

# OpenAI configuration
OPENAI_API_KEY=your_openai_api_key_here

# API configuration
BACKEND_CORS_ORIGINS=http://localhost:3000,https://d2b4b685-66a1-4946-9970-01e9da7727d3.preview.emergentagent.com

# Scraping configuration
SCRAPE_TIMEOUT_SECONDS=15
SCRAPE_MAX_RETRIES=3
SCRAPE_CACHE_TTL_SECONDS=600

# Logging
LOG_LEVEL=INFO